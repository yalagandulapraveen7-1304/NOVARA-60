# NOVARA Antarctic Digital Twin - Environment Configuration Template

# --- BACKEND SETTINGS (Render / Local) ---
PORT=8000
PYTHON_VERSION=3.11.9
# Comma-separated list of allowed origins, or "*"
CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:3000

# Simulation Configuration
SIMULATION_MODE=true

# Optional LLM / Advisory Provider API Key (if using Groq optimizer models)
GROQ_API_KEY=

# --- FRONTEND SETTINGS (Vercel) ---
# Set in Vercel project Environment Variables
VITE_API_URL=https://your-backend-app.onrender.com
